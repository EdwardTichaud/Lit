    "m_SourceType": 1,
    "m_FunctionName": "RimExposure",
    "m_FunctionSource": "",
    "m_FunctionBody": "// HDRP emission is exposed with the camera; dividing by the exposure makes RimStrength 1 look the same in any scene.\n#ifdef SHADERGRAPH_PREVIEW\nOut = In;\n#else\nOut = In * GetInverseCurrentExposureMultiplier();\n#endif\n"
}

