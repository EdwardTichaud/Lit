--- !u!114 &2130536332127093964
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2863410437890911163}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcdbb0b598fece24d9617cee6ae098e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  edit: 1
  note: "Tactical Brain:\r\nThis character uses a child class of the Brain script
    and overrides the chasing behaviour.\r\nWhen it sees a target, it moves to the
    nearest safe spot relative to the target. \r\nAfter a short delay, it peeks from
    the safest visible spot to attack or observe \u2014 similar to a soldier's tactical
    behaviour.\r\nSpots are provided by another script in the scene called \"TacticalSpots\".\r\n\r\nBrain
    Modes:\r\n1. Engage  \u2192 Keeps engaging even if the target gets close.\r\n2.
    Ranger  \u2192 Retreats if the target crosses moveRange.x.\r\n3. Coward  \u2192
    Always runs away from the target.\r"
