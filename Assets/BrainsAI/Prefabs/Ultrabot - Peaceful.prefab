--- !u!114 &8695353292178131165
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7819198454595713318}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcdbb0b598fece24d9617cee6ae098e8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  edit: 0
  note: "Peaceful Brain:\r\n\r\nThis agent has no target layer assigned and uses
    a different alarm group, \r\nso it will not engage with enemies or other agents.\r\n\r\nHowever,
    if an agent from the same group triggers an alarm noise, \r\nit will still respond
    by investigating the noise location. \r\nIt will not chase or attack the target
    \u2014 instead, it will either ignore \r\nor escape depending on how the brain
    is configured.\r\n\r\nIdeal for civilians, bystanders, villagers, or passive
    NPCs that react \r\nto disturbances without becoming aggressive."
