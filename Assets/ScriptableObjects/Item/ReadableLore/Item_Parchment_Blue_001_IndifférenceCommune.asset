  m_Script: {fileID: 11500000, guid: 46548cde82ea81340a3ae6bdb5f758ea, type: 3}
  m_Name: "Item_Parchment_Blue_001_Indiff\xE9renceCommune"
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemId: "READ_RED_004_Indiff\xE9rence commune"
  itemName: "R\xE9flexion sur l'indiff\xE9rence des nouvelles g\xE9n\xE9rations"
  itemSprite: {fileID: 0}
  description: "R\xE9flexion sur l'indiff\xE9rence des nouvelles g\xE9n\xE9rations"
  readableKind: 2
  parchmentText: "De nos jours, les jeunes ne semblent plus \xEAtre curieux, ni se
    soucier de l'avenir.\nOh je leur ait bien dit plusieurs fois mais leur point
    de vue est... diff\xE9rent...\nComme le mien l'\xE9tait jadis.\nJe m'inqui\xE8te
    pour eux. Les esp\xE9rents ne sont pas tr\xE8s curieux de nature.\nLa curiosit\xE9
    serait un vilain d\xE9faut.\nPourquoi pas, mais c'est aussi une des rares choses
    qui permet de s'\xE9manciper et de r\xE9fl\xE9chir par nous m\xEAme.\nLe jour
    J approche. J'ai espoir que cette note sera trouv\xE9e par un curieux qui regarde
    plus haut que sa pointe de pied.\nSi c'est le cas, toi qui lit ce texte, regarde
    \xE0 ta droite. "
