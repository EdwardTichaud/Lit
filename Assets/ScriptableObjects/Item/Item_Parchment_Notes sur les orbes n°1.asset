  m_Script: {fileID: 11500000, guid: 46548cde82ea81340a3ae6bdb5f758ea, type: 3}
  m_Name: "Item_Parchment_Notes sur les orbes n\xB01"
  m_EditorClassIdentifier: Assembly-CSharp::Item
  itemId: item_parchment_orbes_1
  itemName: Parchemin
  itemSprite: {fileID: 0}
  description: "Notes sur les orbes n\xB01"
  readableKind: 2
  parchmentText: "Il s'est pass\xE9 un ph\xE9nom\xE8ne \xE9trange avec un des orbes
    de lumi\xE8re. Un jour, alors que j'\xE9tais encombr\xE9 \xE0 porter des parchemins,
    des pommes et des orbes pour aller \xE9tudier dans la biblioth\xE8que, j'ai laiss\xE9
    tomb\xE9 un de mes orbes. Celui-ci \xE0 roul\xE9 jusqu'\xE0 d\xE9valer les escaliers
    et tomber 3 m\xE8tres plus bas. Je l'ai observ\xE9 et il semblait intact. Je
    n'ai pas souhait\xE9 reit\xE9rer l'exp\xE9rience avec d'autres orbes mais j'ai
    \xE9t\xE9 \xE9tonn\xE9e de voir qu'ils n\xE9taient pas si fragiles."
