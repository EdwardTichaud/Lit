MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8191000543637260959}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9f0a776582cac8d4ab82debddfc918ff, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AurellReunionCycle
  cycle: {fileID: 8191000543637260961}
  reunion: {fileID: 1002346181566443277}
  bindings: {fileID: 5282962463003982441}
  meeting: {fileID: 151360334}
  presentation: {fileID: 5723828045421482618}
  aurell: {fileID: 4358282766840525908}
  introduction:
  - speakerCharacterData: {fileID: 11400000, guid: 0f3452bd8cf87c440ab2208e8ebc72ce, type: 2}
    id: absence_1
    condition:
      requirements:
        mode: 0
        conditions: []
      allFlags: 0
      anyFlags: 0
      knowledge: []
    line: "Attends\u2026 O\xF9 sont les autres ? Ils \xE9taient juste derri\xE8re moi."
    durationSeconds: 5
    blocksGameplayInput: 0
  - speakerCharacterData: {fileID: 11400000, guid: 0f3452bd8cf87c440ab2208e8ebc72ce, type: 2}
    id: absence_2
    condition:
      requirements:
        mode: 0
        conditions: []
      allFlags: 0
      anyFlags: 0
      knowledge: []
    line: "Non, je ne les vois pas non plus\u2026"
    durationSeconds: 4
    blocksGameplayInput: 0
  - speakerCharacterData: {fileID: 11400000, guid: 0f3452bd8cf87c440ab2208e8ebc72ce, type: 2}
    id: absence_3
    condition:
      requirements:
        mode: 0
        conditions: []
      allFlags: 0
      anyFlags: 0
      knowledge: []
    line: "Tu crois qu\u2019ils sont d\xE9j\xE0 entr\xE9s ? Sans nous attendre ?"
    durationSeconds: 5
    blocksGameplayInput: 0
  - speakerCharacterData: {fileID: 11400000, guid: 0f3452bd8cf87c440ab2208e8ebc72ce, type: 2}
    id: absence_4
    condition:
      requirements:
        mode: 0
        conditions: []
      allFlags: 0
      anyFlags: 0
      knowledge: []
    line: "D\u2019accord\u2026 On avance. Mais on les retrouve."
    durationSeconds: 4
    blocksGameplayInput: 0
